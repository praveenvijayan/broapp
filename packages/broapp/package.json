{
  "name": "broapp",
  "version": "0.1.0",
  "type": "module",
  "description": "Build tooling and runtime for local applications made of a Bun host, a browser UI, and a Brobridge connection between them",
  "license": "MIT",
  "homepage": "https://github.com/praveenvijayan/broapp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveenvijayan/broapp.git",
    "directory": "packages/broapp"
  },
  "bugs": {
    "url": "https://github.com/praveenvijayan/broapp/issues"
  },
  "keywords": [
    "bun",
    "brobridge",
    "local-first",
    "desktop",
    "browser-ui",
    "single-file-executable"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "broapp": "./src/cli/main.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/shared/index.ts",
    "./shared": "./src/shared/index.ts",
    "./host": "./src/host/index.ts",
    "./client": "./src/client/index.ts",
    "./react": "./src/react/index.ts",
    "./build": "./src/cli/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@brobridgejs/client": "^0.2.0",
    "@brobridgejs/core": "^0.2.0",
    "brobridge": "^0.2.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  }
}
