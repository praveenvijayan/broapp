{
  "name": "broapp-autoapp",
  "version": "0.3.2",
  "type": "module",
  "description": "A Broapp application its owner can reshape while using it: launcher, renderer, specification, engineer, activation",
  "license": "MIT",
  "homepage": "https://github.com/praveenvijayan/broapp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveenvijayan/broapp.git",
    "directory": "packages/broapp-autoapp"
  },
  "bugs": {
    "url": "https://github.com/praveenvijayan/broapp/issues"
  },
  "keywords": [
    "broapp",
    "autoapp",
    "local-first",
    "ai-agent",
    "mcp",
    "self-modifying",
    "bun",
    "desktop"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist/launcher-page.html",
    "dist/starter-template.json",
    "presets",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./shared": "./src/shared/index.ts",
    "./child": "./src/child/index.ts",
    "./host": "./src/host/index.ts",
    "./engineer": "./src/engineer/index.ts",
    "./knowledge": "./src/knowledge/index.ts",
    "./launcher": "./src/launcher/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./spec": "./src/spec/index.ts",
    "./workflows": "./src/workflows/index.ts",
    "./react": "./src/react/index.tsx",
    "./react/tokens.css": "./src/react/tokens.css",
    "./react/view.css": "./src/react/view.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "broapp": "^0.4.1",
    "broapp-ai-anthropic": "^0.3.0",
    "broapp-ai-compatible": "^0.3.0",
    "broapp-ai-elements": ">=0.4.2"
  },
  "peerDependencies": {
    "ai": "7.0.93",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "broapp-ai-elements": "workspace:*",
    "react": "^19.0.0"
  },
  "bin": {
    "broapp-autoapp": "src/launcher/main.ts"
  },
  "scripts": {
    "build:tokens": "bun run scripts/build-tokens.ts",
    "build:page": "bun run scripts/build-page.ts",
    "build:template": "bun run scripts/build-template.ts",
    "build:assets": "bun run build:tokens && bun run build:page && bun run build:template",
    "build:launcher": "bun run scripts/build-launcher.ts",
    "build:all": "bun run scripts/build-launcher.ts --all-targets",
    "theme-gallery": "bun run scripts/theme-gallery.ts"
  }
}
