{
  "name": "@broapp/workspace",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "Broapp — a starter kit for local applications built on Bun, a browser UI, and Brobridge",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "test": "bun test tests packages",
    "check": "bun run typecheck && bun run test",
    "pack:local": "bun run scripts/pack-local.ts",
    "dryrun": "bun run scripts/release-dry-run.ts",
    "dryrun:autoapp": "bun run scripts/autoapp-dry-run.ts",
    "site": "bun run scripts/build-site.ts",
    "smoke": "bun run scripts/smoke-binary.ts",
    "theme-check": "bun run scripts/theme-check.ts"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.96",
    "@brobridgejs/client": "^0.2.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "ai": "7.0.93",
    "broapp": "workspace:*",
    "broapp-ai-anthropic": "workspace:*",
    "broapp-ai-compatible": "workspace:*",
    "broapp-ai-elements": "workspace:*",
    "broapp-autoapp": "workspace:*",
    "brobridge": "^0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.42.0",
    "nanoid": "6.0.1",
    "playwright": "1.63.0",
    "radix-ui": "1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "streamdown": "2.6.0",
    "tailwind-merge": "3.6.0",
    "typescript": "^5.7.2",
    "use-stick-to-bottom": "1.1.6",
    "ws": "^8.21.3"
  }
}
